{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-local",
  "description": "Registered local document child WebViews; Rust validates exact local origin, document identity and native parent.",
  "remote": {
    "urls": [
      "http://127.0.0.1:*/"
    ]
  },
  "local": false,
  "permissions": [
    "allow-desktop-ready",
    "allow-desktop-close-ack",
    "allow-desktop-open-logs",
    "allow-desktop-open-project",
    "allow-desktop-pick-directory",
    "allow-desktop-print",
    "allow-desktop-window-state",
    "allow-desktop-window-action",
    "allow-desktop-open-data-directory",
    "allow-desktop-prepare-export",
    "allow-desktop-write-export",
    "allow-desktop-finish-export",
    "allow-desktop-cancel-export",
    "allow-desktop-documents"
  ],
  "webviews": [
    "doc-*"
  ]
}
